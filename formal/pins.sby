# keyer_pins: open-drain pins never driven high, host-owned outputs fixed,
# two-cycle input synchroniser, two-cycle edge history. Full proof.
[options]
mode prove
depth 8

[engines]
smtbmc z3

[script]
read -formal keyer_pins.v
read -formal pins_props.sv
prep -top pins_props

[files]
../src/keyer_pins.v
pins_props.sv
