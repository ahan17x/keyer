# keyer_fifo. Occupancy (count/empty/full bookkeeping) is fully proved by
# k-induction; first-in-first-out data integrity (DATA_CHECK) is checked by
# BMC to depth 20, since an inductive proof would need an invariant over the
# memory contents. Proved on the DEPTH=4 / WIDTH=4 instance; the RTL is
# parameter-generic.
[tasks]
prove
bmc

[options]
prove: mode prove
prove: depth 8
bmc: mode bmc
bmc: depth 20

[engines]
smtbmc z3

[script]
read -formal keyer_fifo.v
prove: read -formal fifo_props.sv
bmc: read -formal -DDATA_CHECK fifo_props.sv
prep -top fifo_props

[files]
../src/keyer_fifo.v
fifo_props.sv
